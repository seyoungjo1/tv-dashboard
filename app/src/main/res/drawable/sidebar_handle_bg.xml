<?xml version="1.0" encoding="utf-8"?>
<!-- 사이드바에 붙은 탭 손잡이: 반투명(뒤의 대시보드가 비침), 오른쪽 모서리만 둥글게 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#CC33373C" />
            <corners android:topRightRadius="10dp" android:bottomRightRadius="10dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#CC33373C" />
            <corners android:topRightRadius="10dp" android:bottomRightRadius="10dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#73121416" />
            <corners android:topRightRadius="10dp" android:bottomRightRadius="10dp" /></shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/tile" /><corners android:radius="14dp" />
            <stroke android:width="4dp" android:color="@color/focus" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="@color/tile" /><corners android:radius="14dp" />
            <stroke android:width="4dp" android:color="@color/accent" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/tile" /><corners android:radius="14dp" />
            <stroke android:width="4dp" android:color="@android:color/transparent" /></shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/sidebar_focus" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/sidebar_focus" /></shape>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item><shape><solid android:color="@color/sidebar_selected" /></shape></item>
            <item android:gravity="start|fill_vertical" android:width="4dp">
                <shape><solid android:color="@color/accent" /></shape></item>
        </layer-list>
    </item>
    <item><shape><solid android:color="@android:color/transparent" /></shape></item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/content_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 상단 헤더: 화면보호기와 같은 배치 — 왼쪽 로고 · 가운데 제목 · 오른쪽 날짜 │ 시각 -->
        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height"
            android:background="@color/header"
            android:paddingStart="22dp"
            android:paddingEnd="28dp">

            <ImageView
                android:id="@+id/headerLogo"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:maxWidth="200dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_daesang_mark" />

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:ellipsize="end"
                android:fontFamily="@font/pretendard_extrabold"
                android:maxLines="1"
                android:maxWidth="760dp"
                android:text="@string/default_header_title"
                android:textColor="#FFFFFFFF"
                android:textSize="32sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/headerDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_bold"
                    android:textColor="#FFAEB8C2"
                    android:textSize="20sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginHorizontal="18dp"
                    android:background="#FF4A525B" />

                <TextView
                    android:id="@+id/headerClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_extrabold"
                    android:textColor="#FFFFFFFF"
                    android:textSize="28sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- 왼쪽 사이드바: 정사각형 아이콘 메뉴, 맨 아래 설정 -->
            <LinearLayout
                android:id="@+id/menuPanel"
                android:layout_width="@dimen/sidebar_width"
                android:layout_height="match_parent"
                android:background="@color/sidebar"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/menuList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:descendantFocusability="afterDescendants"
                    android:scrollbars="none" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FF3C4147" />

                <!-- 대기화면 바로보기 (설정 바로 위) -->
                <LinearLayout
                    android:id="@+id/idleNowButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/side_item_bg"
                    android:clickable="true"
                    android:contentDescription="@string/idle_now"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_idle_now" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/idle_now"
                        android:textColor="@color/sidebar_text"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/settingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/side_item_bg"
                    android:clickable="true"
                    android:contentDescription="@string/settings"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_settings" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/settings"
                        android:textColor="@color/sidebar_text"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 오른쪽: 대시보드(index.html) -->
            <FrameLayout
                android:id="@+id/contentPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/content_bg">

                <!-- WebView 는 코드에서 생성 (렌더러 종료 시 재생성) -->
                <FrameLayout
                    android:id="@+id/webContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ScrollView
                    android:id="@+id/emptyView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/content_bg"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/emptyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="32dp"
                        android:background="#FFFFFFFF"
                        android:elevation="2dp"
                        android:lineSpacingExtra="6dp"
                        android:padding="32dp"
                        android:textColor="@color/content_text"
                        android:textSize="20sp" />
                </ScrollView>

                <ImageButton
                    android:id="@+id/fullscreenButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:alpha="0.7"
                    android:background="@drawable/round_button_bg"
                    android:contentDescription="@string/fullscreen"
                    android:focusable="true"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_fullscreen" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 사이드바 오른쪽 아래에 붙은 숨기기/열기 손잡이 (◁ / ▷) — 대시보드 위에 반투명으로 겹쳐 표시.
         왼쪽 여백은 코드가 사이드바 폭(열림) 또는 0(닫힘)으로 맞춘다 -->
    <TextView
        android:id="@+id/sidebarToggle"
        android:layout_width="@dimen/sidebar_handle_width"
        android:layout_height="@dimen/sidebar_handle_height"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/sidebar_width"
        android:layout_marginBottom="28dp"
        android:background="@drawable/sidebar_handle_bg"
        android:clickable="true"
        android:contentDescription="@string/toggle_sidebar"
        android:focusable="true"
        android:gravity="center"
        android:text="◁"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp" />

    <!-- 일정 시간 무입력 시: 루트 동영상 + 멘트 오버레이 -->
    <FrameLayout
        android:id="@+id/idleOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <VideoView
            android:id="@+id/idleVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- 화면보호기: 자료/main 폴더가 있으면 대기 화면 대신 표시 (assets/screensaver + 동영상) -->
        <FrameLayout
            android:id="@+id/ssLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFEAEEF3"
            android:visibility="gone">

            <!-- 동영상 칸: 위치·크기는 화면보호기 페이지가 알려 준다. 비율이 다르면 가운데 원본 + 남는 곳은 흐리게 -->
            <FrameLayout
                android:id="@+id/ssVideoBox"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#FF0D1620"
                android:visibility="invisible">

                <ImageView
                    android:id="@+id/ssBlur"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <View
                    android:id="@+id/ssDim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#40000000" />

                <TextureView
                    android:id="@+id/ssVideo"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_gravity="center" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/idleMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="64dp"
            android:background="#B3000000"
            android:gravity="center"
            android:paddingHorizontal="36dp"
            android:paddingVertical="18dp"
            android:layout_marginHorizontal="24dp"
            android:maxLines="3"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 화면 전환 효과: 누른 자리에서 동그라미가 퍼지며 화면을 덮고, 새 화면으로 바뀐 뒤 사라진다 -->
    <View
        android:id="@+id/revealOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/content_bg"
        android:importantForAccessibility="no"
        android:visibility="invisible" />
</FrameLayout>

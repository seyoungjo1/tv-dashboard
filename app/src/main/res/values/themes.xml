<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvDashboard" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/content_bg</item>
        <item name="colorPrimary">@color/panel</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="fontFamily">@font/pretendard_bold</item>
    </style>
    <style name="Theme.TvDashboard.Settings" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/panel</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="fontFamily">@font/pretendard_bold</item>
    </style>
</resources>
